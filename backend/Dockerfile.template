FROM python:3.11-slim

WORKDIR /app

# System dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    curl \
    && rm -rf /var/lib/apt/lists/*

# We would copy a shared requirements.txt in real life, but we'll mock it for now
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Copy the service specific code
# This template assumes we build from the context of the specific service directory
COPY . /app

EXPOSE 8000

# uvicorn main:app --host 0.0.0.0 --port 8000
CMD ["python", "main.py"]
