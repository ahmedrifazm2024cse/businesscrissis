# Server Settings
PORT=8000
ENVIRONMENT=development

# Database Configuration
# Fallback is sqlite:///./market_intelligence.db
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/market_intelligence

# LLM Config (OpenAI API key is required for CrewAI agents)
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL_NAME=gpt-4o

# Sample Data Path (Override if necessary)
SAMPLE_DATA_DIR=../sample-data
